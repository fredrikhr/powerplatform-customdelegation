<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>pwrplatf_ManagedIdentityFrameworkPlugins</PackageId>
    <Version>3.0.0</Version>
    <Description>No package description provided</Description>
  </PropertyGroup>

  <PropertyGroup
    Condition="Exists('$(MSBuildThisFileDirectory)..\..\bld\PluginPackage-SigningCertificate.pfx')"
  >
    <PackageSigningCertificatePath>$(MSBuildThisFileDirectory)..\..\bld\PluginPackage-SigningCertificate.pfx</PackageSigningCertificatePath>
    <PackageSigningCertificatePassword></PackageSigningCertificatePassword>
    <PackageSignatureTimestamper>http://timestamp.acs.microsoft.com</PackageSignatureTimestamper>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="..\..\.submodules\fredrikhr\powerplatform-sdk-extensions\libraries\FredrikHr.PowerPlatformSdkExtensions.PluginRuntime\FredrikHr.PowerPlatformSdkExtensions.PluginRuntime.csproj"
      Pack="true"
    />
    <ProjectReference
      Include="..\..\libraries\FredrikHr.PowerPlatformManagedIdentityFramework.Common\FredrikHr.PowerPlatformManagedIdentityFramework.Common.csproj"
      Pack="true"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="
        FredrikHr.NupkgMSBuild.PackageAuthorSigning;
        FredrikHr.NupkgMSBuild.PackPackageReference;
        "
    >
      <PrivateAssets>all</PrivateAssets>
      <ProjectReference>$(MSBuildThisFileDirectory)..\..\.submodules\fredrikhr\powerplatform-sdk-extensions\.submodules\fredrikhr\nuget-msbuild-extensions\build\%(Identity)\%(Identity).csproj</ProjectReference>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="
        Microsoft.Identity.Client;
        Microsoft.IdentityModel.Tokens;
        Microsoft.IdentityModel.JsonWebTokens;
        Microsoft.IdentityModel.Protocols;
        Microsoft.IdentityModel.Protocols.OpenIdConnect;
        System.IdentityModel.Tokens.Jwt;
        "
      PrivateAssets="all"
    />
  </ItemGroup>

  <ItemGroup>
    <PackageReference
      Include="
        Azure.Core;
        Azure.Security.KeyVault.Certificates;
        Azure.Security.KeyVault.Secrets;
        Azure.ResourceManager;
        Azure.ResourceManager.Authorization;
        Azure.ResourceManager.KeyVault;
        Azure.Security.KeyVault.Keys;
        System.ClientModel;
        System.Memory.Data;
        "
      PrivateAssets="all"
      Pack="true"
    />
  </ItemGroup>

</Project>
