{
  "properties": {
    "connectionReferences": {
      "dataverse": {
        "impersonation": {
          "source": "invoker"
        },
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "test_fredrikhr_customdelegation_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        },
        "test_fredrikhr_customdelegation_appid": {
          "type": "String",
          "metadata": {
            "schemaName": "test_fredrikhr_customdelegation_appid"
          }
        },
        "test_fredrikhr_customdelegation_keyvaulturi": {
          "type": "String",
          "metadata": {
            "schemaName": "test_fredrikhr_customdelegation_keyvaulturi"
          }
        },
        "test_fredrikhr_customdelegation_keyvaultsecretname": {
          "type": "String",
          "metadata": {
            "schemaName": "test_fredrikhr_customdelegation_keyvaultsecretname"
          }
        },
        "test_fredrikhr_customdelegation_keyvaultcertificatename": {
          "type": "String",
          "metadata": {
            "schemaName": "test_fredrikhr_customdelegation_keyvaultcertificatename"
          }
        }
      },
      "triggers": {
        "manual": {
          "type": "Request",
          "kind": "Button",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "grantType": {
                  "title": "Client Authorization",
                  "type": "string",
                  "x-ms-dynamically-added": true,
                  "description": "Source credentials for Client Authorization",
                  "x-ms-content-hint": "TEXT",
                  "enum": [
                    "Client Secret",
                    "Client Certificate"
                  ]
                }
              },
              "required": [
                "grantType"
              ]
            }
          }
        }
      },
      "actions": {
        "Redirect_URI": {
          "runAfter": {},
          "type": "Compose",
          "inputs": {
            "commonRedirectUri": "https://login.microsoftonline.com/common/oauth2/nativeclient",
            "oneTimeRedirectUri": "https://example.org/random-url/@{formatNumber(rand(0, 32767), 'F0', '')}"
          }
        },
        "PKCE_Parameters": {
          "runAfter": {
            "Redirect_URI": [
              "Succeeded"
            ]
          },
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "actionName": "pwrplatf_GeneratePkceParameters"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "PerformUnboundAction",
              "connectionName": "dataverse"
            }
          }
        },
        "Switch_on_Client_Authorization_type": {
          "runAfter": {
            "PKCE_Parameters": [
              "Succeeded"
            ]
          },
          "type": "Switch",
          "expression": "@triggerBody()?['grantType']",
          "cases": {
            "Client_Certificate": {
              "case": "Client Certificate",
              "actions": {
                "Authorization_URL_(Client_certificate)": {
                  "runAfter": {},
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "actionName": "pwrplatf_GenerateAuthorizationUrl",
                      "item/OneTimeRedirectUri": "@outputs('Redirect_URI')['oneTimeRedirectUri']",
                      "item/ResponseMode": "fragment",
                      "item/Scopes": [
                        "openid",
                        "offline_access"
                      ],
                      "item/NonceParameter": "@body('PKCE_Parameters')?['NonceParameter']",
                      "item/PkceS256CodeChallenge": "@body('PKCE_Parameters')['PkceCodeChallenge']",
                      "item/CommonRedirectUri": "@outputs('Redirect_URI')['commonRedirectUri']",
                      "item/IncludeIdToken": true,
                      "item/Application": {
                        "@@odata.type": "Microsoft.Dynamics.CRM.managedidentity",
                        "applicationid": "@parameters('test_fredrikhr_customdelegation_appid')"
                      },
                      "item/ClientCredentialsSource": {
                        "@@odata.type": "Microsoft.Dynamics.CRM.keyvaultreference",
                        "keytype": 1,
                        "keyvaulturi": "@parameters('test_fredrikhr_customdelegation_keyvaulturi')",
                        "keyname": "@parameters('test_fredrikhr_customdelegation_keyvaultcertificatename')"
                      }
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "connectionName": "dataverse"
                    }
                  }
                },
                "Authorization_URL_query_JSON_partials_(Client_certificate)": {
                  "runAfter": {
                    "Authorization_URL_(Client_certificate)": [
                      "Succeeded"
                    ]
                  },
                  "type": "Select",
                  "inputs": {
                    "from": "@split(substring(uriQuery(body('Authorization_URL_(Client_certificate)')['AuthorizationRequestUrl']), 1), '&')",
                    "select": "@slice(string(addProperty(json('{}'), decodeUriComponent(substring(item(), 0, indexOf(item(), '='))), decodeUriComponent(substring(item(), add(1, indexOf(item(), '=')))))), 1, -1)"
                  }
                },
                "Authorization_URL_query_(Client_certificate)": {
                  "runAfter": {
                    "Authorization_URL_query_JSON_partials_(Client_certificate)": [
                      "Succeeded"
                    ]
                  },
                  "type": "ParseJson",
                  "inputs": {
                    "content": "@concat('{', join(body('Authorization_URL_query_JSON_partials_(Client_certificate)'), ','), '}')",
                    "schema": {
                      "type": "object",
                      "properties": {
                        "state": {
                          "type": "string",
                          "title": "Authorization State"
                        }
                      },
                      "required": [
                        "state"
                      ]
                    }
                  }
                },
                "Decode_Authorization_state_(Client_certificate)": {
                  "runAfter": {
                    "Authorization_URL_query_(Client_certificate)": [
                      "Succeeded"
                    ]
                  },
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "actionName": "pwrplatf_DecodeAuthorizationUrlState",
                      "item/State": "@body('Authorization_URL_(Client_certificate)')['State']"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "PerformUnboundAction",
                      "connectionName": "dataverse"
                    }
                  }
                },
                "Compare_One-Time_Redirect_URI_(Client_certificate)": {
                  "runAfter": {
                    "Decode_Authorization_state_(Client_certificate)": [
                      "Succeeded"
                    ]
                  },
                  "type": "Compose",
                  "inputs": {
                    "pre-encode": "@outputs('Redirect_URI')['oneTimeRedirectUri']",
                    "post_decode": "@body('Decode_Authorization_state_(Client_certificate)')['OneTimeRedirectUrl']",
                    "equal": "@equals(outputs('Redirect_URI')['oneTimeRedirectUri'], body('Decode_Authorization_state_(Client_certificate)')['OneTimeRedirectUrl'])"
                  }
                }
              }
            }
          },
          "default": {
            "actions": {
              "Authorization_URL_(Client_secret)": {
                "runAfter": {},
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "actionName": "pwrplatf_GenerateAuthorizationUrl",
                    "item/OneTimeRedirectUri": "@outputs('Redirect_URI')['oneTimeRedirectUri']",
                    "item/ResponseMode": "fragment",
                    "item/Scopes": [
                      "openid",
                      "offline_access"
                    ],
                    "item/NonceParameter": "@body('PKCE_Parameters')?['NonceParameter']",
                    "item/PkceS256CodeChallenge": "@body('PKCE_Parameters')['PkceCodeChallenge']",
                    "item/CommonRedirectUri": "@outputs('Redirect_URI')['commonRedirectUri']",
                    "item/IncludeIdToken": true,
                    "item/Application": {
                      "@@odata.type": "Microsoft.Dynamics.CRM.managedidentity",
                      "applicationid": "@parameters('test_fredrikhr_customdelegation_appid')"
                    },
                    "item/ClientCredentialsSource": {
                      "@@odata.type": "Microsoft.Dynamics.CRM.keyvaultreference",
                      "keytype": 0,
                      "keyvaulturi": "@parameters('test_fredrikhr_customdelegation_keyvaulturi')",
                      "keyname": "@parameters('test_fredrikhr_customdelegation_keyvaultsecretname')"
                    }
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "PerformUnboundAction",
                    "connectionName": "dataverse"
                  }
                }
              },
              "Authorization_URL_query_JSON_partials_(Client_secret)": {
                "runAfter": {
                  "Authorization_URL_(Client_secret)": [
                    "Succeeded"
                  ]
                },
                "type": "Select",
                "inputs": {
                  "from": "@split(substring(uriQuery(body('Authorization_URL_(Client_secret)')['AuthorizationRequestUrl']), 1), '&')",
                  "select": "@slice(string(addProperty(json('{}'), decodeUriComponent(substring(item(), 0, indexOf(item(), '='))), decodeUriComponent(substring(item(), add(1, indexOf(item(), '=')))))), 1, -1)"
                }
              },
              "Authorization_URL_query_(Client_secret)": {
                "runAfter": {
                  "Authorization_URL_query_JSON_partials_(Client_secret)": [
                    "Succeeded"
                  ]
                },
                "type": "ParseJson",
                "inputs": {
                  "content": "@concat('{', join(body('Authorization_URL_query_JSON_partials_(Client_secret)'), ','), '}')",
                  "schema": {
                    "type": "object",
                    "properties": {
                      "state": {
                        "type": "string",
                        "title": "Authorization State"
                      }
                    },
                    "required": [
                      "state"
                    ]
                  }
                }
              },
              "Decode_Authorization_state_(Client_secret)": {
                "runAfter": {
                  "Authorization_URL_query_(Client_secret)": [
                    "Succeeded"
                  ]
                },
                "type": "OpenApiConnection",
                "inputs": {
                  "parameters": {
                    "actionName": "pwrplatf_DecodeAuthorizationUrlState",
                    "item/State": "@body('Authorization_URL_(Client_secret)')['State']"
                  },
                  "host": {
                    "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                    "operationId": "PerformUnboundAction",
                    "connectionName": "dataverse"
                  }
                }
              },
              "Compare_One-Time_Redirect_URI_(Client_secret)": {
                "runAfter": {
                  "Decode_Authorization_state_(Client_secret)": [
                    "Succeeded"
                  ]
                },
                "type": "Compose",
                "inputs": {
                  "pre-encode": "@outputs('Redirect_URI')['oneTimeRedirectUri']",
                  "post_decode": "@body('Decode_Authorization_state_(Client_secret)')['OneTimeRedirectUrl']",
                  "equal": "@equals(outputs('Redirect_URI')['oneTimeRedirectUri'], body('Decode_Authorization_state_(Client_secret)')['OneTimeRedirectUrl'])"
                }
              }
            }
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}
