{
  "properties": {
    "connectionReferences": {
      "dataverse": {
        "impersonation": {
          "source": "invoker"
        },
        "runtimeSource": "embedded",
        "connection": {
          "connectionReferenceLogicalName": "pwrplatf_federatedidentity_dataverse"
        },
        "api": {
          "name": "shared_commondataserviceforapps"
        }
      }
    },
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "contentVersion": "1.0.0.0",
      "parameters": {
        "$authentication": {
          "defaultValue": {},
          "type": "SecureObject"
        },
        "$connections": {
          "defaultValue": {},
          "type": "Object"
        }
      },
      "triggers": {
        "When_a_child_row_is_added_or_modified": {
          "type": "OpenApiConnectionWebhook",
          "inputs": {
            "parameters": {
              "subscriptionRequest/message": 4,
              "subscriptionRequest/entityname": "az_keyvaultreference",
              "subscriptionRequest/scope": 4,
              "subscriptionRequest/runas": 1
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "SubscribeWebhookTrigger",
              "connectionName": "dataverse"
            }
          },
          "conditions": [
            {
              "expression": "@not(equals(triggerBody()?['_az_templatesourceid_value'], null))"
            }
          ]
        }
      },
      "actions": {
        "Parent": {
          "runAfter": {},
          "type": "OpenApiConnection",
          "inputs": {
            "parameters": {
              "entityName": "az_keyvaultreferences",
              "recordId": "@triggerBody()['_az_templatesourceid_value']",
              "x-ms-odata-metadata-full": false,
              "$select": "az_keyvaultreferenceid",
              "$expand": "az_keyvaultreference_parent($select=az_keyvaultreferenceid),az_keyvaultreference_parentcomponent($select=keyvaultreferenceid)"
            },
            "host": {
              "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
              "operationId": "GetItem",
              "connectionName": "dataverse"
            }
          }
        },
        "Switch_Parent.Parent": {
          "runAfter": {
            "Parent": [
              "Succeeded"
            ]
          },
          "type": "Switch",
          "expression": "@if(not(equals(body('Parent')?['az_keyvaultreference_parent']?['az_keyvaultreferenceid'], null)), 'az_keyvaultreference_parent', if(not(equals(body('Parent')?['az_keyvaultreference_parentcomponent']?['keyvaultreferenceid'], null)), 'az_keyvaultreference_parentcomponent',''))",
          "cases": {
            "Case_Parent": {
              "case": "az_keyvaultreference_parent",
              "actions": {
                "this.Parent_=_Parent.Parent": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "az_keyvaultreferences",
                      "recordId": "@triggerBody()['az_keyvaultreferenceid']",
                      "x-ms-odata-metadata-full": false,
                      "item/az_keyvaultreference_parent@odata.bind": "az_keyvaultreferences(@{body('Parent')['az_keyvaultreference_parent']['az_keyvaultreferenceid']})"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "dataverse"
                    }
                  }
                }
              }
            },
            "Case_Parent_(component)": {
              "case": "az_keyvaultreference_parentcomponent",
              "actions": {
                "this.Parent_(component)_=_Parent.Parent_(component)": {
                  "type": "OpenApiConnection",
                  "inputs": {
                    "parameters": {
                      "entityName": "az_keyvaultreferences",
                      "recordId": "@triggerBody()['az_keyvaultreferenceid']",
                      "x-ms-odata-metadata-full": false,
                      "item/az_keyvaultreference_parentcomponent@odata.bind": "keyvaultreferences(@{body('Parent')['az_keyvaultreference_parentcomponent']['keyvaultreferenceid']})"
                    },
                    "host": {
                      "apiId": "/providers/Microsoft.PowerApps/apis/shared_commondataserviceforapps",
                      "operationId": "UpdateOnlyRecord",
                      "connectionName": "dataverse"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "actions": {}
          }
        }
      }
    },
    "templateName": null
  },
  "schemaVersion": "1.0.0.0"
}